const Database = require('better-sqlite3');
const db = new Database('./database/users.db');

// สร้างตารางเมื่อเริ่มครั้งแรก
db.exec(`
  CREATE TABLE IF NOT EXISTS users (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    race TEXT DEFAULT 'มนุษย์',
    role TEXT DEFAULT 'พลเรือน',
    credits INTEGER DEFAULT 100,
    location TEXT DEFAULT 'ด่านตรวจ',
    clan TEXT DEFAULT NULL,
    companion TEXT DEFAULT NULL,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
  );
`);

module.exports = {
  createUser: (id, name, race, role, clan=null) => {
    const stmt = db.prepare(`INSERT OR IGNORE INTO users 
      (id, name, race, role, credits, clan) VALUES (?, ?, ?, ?, 100, ?)`);
    return stmt.run(id, name, race, role, clan);
  },

  getUser: (id) => db.prepare('SELECT * FROM users WHERE id = ?').get(id),

  updateCredits: (id, amount) => {
    db.prepare('UPDATE users SET credits = credits + ? WHERE id = ?').run(amount, id);
    return getUser(id);
  },

  updateLocation: (id, loc) => {
    db.prepare('UPDATE users SET location = ? WHERE id = ?').run(loc, id);
  },

  setCompanion: (id, name, type) => {
    db.prepare('UPDATE users SET companion = ? WHERE id = ?').run(`${name} (${type})`, id);
  }
};

